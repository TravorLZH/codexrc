#!/bin/sh
#
# vim-check-modified - report target files with unsaved changes in Vim

set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: vim-check-modified FILE..." >&2
    exit 64
fi

# No Vim executable means there is no editor state to inspect.
if ! command -v vim >/dev/null 2>&1; then
    echo "vim-check-modified: Vim executable not found" >&2
    exit 2
fi

if ! servers=$(vim --serverlist 2>&1); then
    echo "vim-check-modified: could not list Vim servers" >&2
    printf '%s\n' "$servers" >&2
    exit 4
fi

# No servers is normal when Vim is not running.
if [ -z "$servers" ]; then
    echo "vim-check-modified: no Vim servers found" >&2
    exit 3
fi

newline='
'
modified=
for server in $servers; do
    # Ask Vim for absolute, resolved paths of named modified buffers.
    marker=__VIM_CHECK_MODIFIED_OK__
    expr="'$marker' . \"\\n\" . join(map(filter(getbufinfo({'bufmodified': 1}), '!empty(v:val.name)'), 'resolve(fnamemodify(v:val.name, \":p\"))'), \"\\n\")"
    if ! response=$(vim --servername "$server" --remote-expr "$expr" 2>&1); then
        echo "vim-check-modified: could not query Vim server '$server'" >&2
        printf '%s\n' "$response" >&2
        exit 5
    fi

    # Vim can exit successfully even when --remote-expr cannot connect. Validate
    # the response marker before treating the remainder as the modified-file list.
    case "$response" in
        "$marker")
            ;;
        "$marker$newline"*)
            server_modified=${response#"$marker$newline"}
            if [ -n "$server_modified" ]; then
                if [ -n "$modified" ]; then
                    modified=$modified$newline$server_modified
                else
                    modified=$server_modified
                fi
            fi
            ;;
        *)
            echo "vim-check-modified: Vim server '$server' returned no valid success marker" >&2
            printf '%s\n' "$response" >&2
            exit 5
            ;;
    esac
done

status=0
for target in "$@"; do
    # Resolve the parent directory without relying on GNU realpath.
    target_name=$(basename "$target")
    if ! target_dir=$(CDPATH= cd -P "$(dirname "$target")" 2>/dev/null && pwd); then
        echo "vim-check-modified: could not resolve target '$target'" >&2
        exit 6
    fi
    target=$target_dir/$target_name

    target_modified=0
    old_ifs=$IFS
    IFS='
'
    for buffer in $modified; do
        # File identity catches paths that reach the same file through symlinks.
        if [ "$buffer" = "$target" ]; then
            target_modified=1
            break
        fi
        if [ -e "$buffer" ] && [ -e "$target" ] && [ "$buffer" -ef "$target" ]; then
            target_modified=1
            break
        fi
    done
    IFS=$old_ifs

    if [ "$target_modified" -eq 1 ]; then
        printf '%s\n' "$target"
        status=1
    fi
done

exit "$status"
