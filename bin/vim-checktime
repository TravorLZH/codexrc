#!/bin/sh
#
# vim-checktime - make Vim check its buffers for external file changes

set -eu

server=${VIM_SERVERNAME:-VIM}

# No Vim executable means there is no editor state to refresh.
if ! command -v vim >/dev/null 2>&1; then
    exit 0
fi

if ! servers=$(vim --serverlist 2>/dev/null); then
    echo "vim-checktime: could not list Vim servers" >&2
    exit 2
fi

# A missing server is normal when Vim is not running.
if ! printf '%s\n' "$servers" | grep -Fqx -- "$server"; then
    exit 0
fi

# A remote expression leaves the current Vim mode unchanged.
if ! vim --servername "$server" --remote-expr "execute('checktime')" >/dev/null 2>&1; then
    echo "vim-checktime: could not query Vim server '$server'" >&2
    exit 2
fi
